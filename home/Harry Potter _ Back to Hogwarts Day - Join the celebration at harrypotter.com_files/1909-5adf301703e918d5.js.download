n:r().bool,ribbonMessageText:r().string,ribbonBackgroundHexCode:r().string,ribbonLinkURL:r().string,ribbonCTAText:r().string})},23394:(e,t,o)=>{"use strict";o.d(t,{h:()=>s});var a,r=o(80080);function i(){return(i=Object.assign?Object.assign.bind():function(e){for(var t=1;t<arguments.length;t++){var o=arguments[t];for(var a in o)({}).hasOwnProperty.call(o,a)&&(e[a]=o[a])}return e}).apply(null,arguments)}let s=e=>r.createElement("svg",i({xmlns:"http://www.w3.org/2000/svg",width:16,height:16},e),a||(a=r.createElement("path",{fill:"#FFF",fillRule:"evenodd",d:"M7.646.147a.5.5 0 0 1 .708 0l3.566 3.566-.707.707L8 1.207 1.207 8 8 14.793l3.252-3.252.707.707-3.605 3.606a.502.502 0 0 1-.708 0l-7.5-7.5a.5.5 0 0 1 0-.707zm5.688 4.98 2.52 2.52a.5.5 0 0 1 0 .707l-2.48 2.48-.708-.707 1.69-1.69H8v-1h6.23l-1.603-1.603.707-.707z"})))},30469:e=>{e.exports={flourish:"Seperator_flourish__bOLjU",hr:"Seperator_hr__bfnn5"}},41502:(e,t,o)=>{"use strict";o.d(t,{A:()=>s});var a=o(80080),r=o(45636),i=o(16827);let s=()=>{let[e,t]=(0,a.useState)(""),{loading:o,data:s}=(0,r.IT)(i.DH,{ssr:!1});return(0,a.useEffect)(()=>{(null==s?void 0:s.country)&&t(s.country.code)},[s]),{loading:o,country:e}}},41967:(e,t,o)=>{"use strict";o.d(t,{A:()=>a});let a={books:{metaContent:{title:"Harry Potter | Harry Potter and Fantastic Beasts Books",description:"J.K Rowling’s original seven Harry Potter books paved the path for the Wizarding World. Read all about them here and explore the spin-offs and screenplays that followed."},header:{eyebrow:"discover the wizarding world",title:"Books",description:"The first Harry Potter book, Harry Potter and the Philosopher’s Stone, was published by Bloomsbury in 1997 to immediate popular and critical acclaim. Six further best-selling books, three companion books, a playscript and two screenplays have since followed. The Harry Potter books have been translated into over 80 languages, won multiple awards, and sold more than 500 million copies worldwide, becoming the best-selling book series in history..."},collections:[{collectionTitle:"Harry Potter",products:[{franchiseName:"Harry Potter",franchiseSubTitle:{UK:"and the Philosopher's Stone",US:"and the Sorcerer's Stone"},displayTitle:{UK:"Harry Potter and the Philosopher's Stone",US:"Harry Potter and the Sorcerer's Stone"},externalId:"harry-potter-and-the-philosophers-stone",seriesNumber:1,imageSet:{US:"/images/products/books/US/rectangle-1.jpg",UK:"/images/products/books/UK/rectangle-1.jpg"},text:{US:"Till now there’s been no magic for Harry Potter. He lives with the miserable Dursleys and their abominable son, Dudley. Harry’s room is a tiny closet at the foot of the stairs, and he hasn’t had a birthday party in eleven years. But then a mysterious letter arrives by owl messenger: a letter with an invitation to an incredible place called the Hogwarts School of Witchcraft and Wizardry. And there he finds not only friends, flying sports on broomsticks, and magic in everything from classes to meals, but a great destiny that’s been waiting for him . . . if Harry can survive the encounter.",UK:"Harry Potter has never even heard of Hogwarts when the letters start dropping on the doormat at number four, Privet Drive. Addressed in green ink on yellowish parchment with a purple seal, they are swiftly confiscated by his grisly aunt and uncle. Then, on Harry’s eleventh birthday, a great beetle-eyed giant of a man called Rubeus Hagrid bursts in with some astonishing news: Harry Potter is a wizard, and he has a place at Hogwarts School of Witchcraft and Wizardry. An incredible adventure is about to begin!"},purchaseLinks:{UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-philosophers-stone-9781408855652",imageSet:"/images/products/books/purchaseLinks/UK/philosophers/print.jpg"},{title:"eBook",link:"http://lnk.to/HP1eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/philosophers/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP1DABWW",imageSet:"/images/products/books/purchaseLinks/UK/philosophers/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-philosophers-stone-9781408882221/",imageSet:"/images/products/books/purchaseLinks/UK/philosophers/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-philosophers-stone-9781408845646",imageSet:"/images/products/books/purchaseLinks/UK/philosophers/illustrated.jpg"}],US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/philosophers/print.jpg"},{title:"eBook",link:"http://lnk.to/HP1eBookWW",imageSet:"/images/products/books/purchaseLinks/US/philosophers/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP1DABWW",imageSet:"/images/products/books/purchaseLinks/US/philosophers/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158330/harry-potter-and-the-sorcerers-stone-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/philosophers/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/philosophers/illustrated.jpg"}]},typeSlug:"books",showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Chamber of Secrets",displayTitle:"Harry Potter and the Chamber of Secrets",externalId:"harry-potter-and-the-chamber-of-secrets",seriesNumber:2,imageSet:{US:"/images/products/books/US/rectangle-2.jpg",UK:"/images/products/books/UK/rectangle-2.jpg"},text:{US:"Harry’s second year at Hogwarts is rife with fresh torments and horrors, including an outrageously stuck-up new professor, Gilderoy Lockhart, a spirit named Moaning Myrtle who haunts the girls’ bathroom, and the unwanted attentions of Ron Weasley’s younger sister, Ginny. But these seem minor when the real trouble begins, and someone — or something — starts turning Hogwarts students to stone. Could it be Draco Malfoy, a more poisonous rival than ever? Could it possibly be Hagrid, whose mysterious past is finally revealed? Or could it be the one everyone at Hogwarts most suspects . . . Harry Potter himself!",UK:"Harry Potter’s summer has included the worst birthday ever, doomy warnings from a house-elf called Dobby, and rescue from the Dursleys by his friend Ron Weasley in a magical flying car! Back at Hogwarts School of Witchcraft And Wizardry for his second year, Harry hears strange whispers echo through empty corridors – and then the attacks start. Students are found as though turned to stone … Dobby’s sinister predictions seem to be coming true."},collectionSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/chamber/print.jpg"},{title:"eBook",link:"http://lnk.to/HP2eBookWW",imageSet:"/images/products/books/purchaseLinks/US/chamber/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP2DABWW",imageSet:"/images/products/books/purchaseLinks/US/chamber/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158321/harry-potter-and-the-chamber-of-secrets-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/chamber/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/chamber/illustrated.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-chamber-of-secrets-9781408855669",imageSet:"/images/products/books/purchaseLinks/UK/chamber/print.jpg"},{title:"eBook",link:"http://lnk.to/HP2eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/chamber/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP2DABWW",imageSet:"/images/products/books/purchaseLinks/UK/chamber/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-chamber-of-secrets-9781408882252/",imageSet:"/images/products/books/purchaseLinks/UK/chamber/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-chamber-of-secrets-9781408845653",imageSet:"/images/products/books/purchaseLinks/UK/chamber/illustrated.jpg"}]},typeSlug:"books",showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Prisoner of Azkaban",displayTitle:"Harry Potter and the Prisoner of Azkaban",externalId:"harry-potter-and-the-prisoner-of-azkaban",seriesNumber:3,imageSet:{US:"/images/products/books/US/rectangle-3.jpg",UK:"/images/products/books/UK/rectangle-3.jpg"},text:{US:"For twelve long years, the dread fortress of Azkaban held an infamous prisoner named Sirius Black. Convicted of killing thirteen people with a single curse, he was said to be a dedicated follower of the Dark Lord, Voldemort. Now he’s escaped. And the Azkaban guards heard Black muttering in his sleep, “He’s at Hogwarts . . . he’s at Hogwarts.” Is he coming for Harry? Harry Potter isn’t safe, not even within the walls of his magical school, surrounded by his friends. Because on top of it all, there may be a traitor in their midst.",UK:"When the Knight Bus crashes through the darkness and screeches to a halt in front of him, it’s the start of another far from ordinary year at Hogwarts for Harry Potter. Sirius Black, escaped mass-murderer and follower of Lord Voldemort, is on the run – and they say he is coming after Harry. In his first ever Divination class, Professor Trelawney sees an omen of death in Harry’s tea leaves... But perhaps most terrifying of all are the Dementors patrolling the school grounds, with their soul-sucking kiss."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/prisoner/print.jpg"},{title:"eBook",link:"http://lnk.to/HP3eBookWW",imageSet:"/images/products/books/purchaseLinks/US/prisoner/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP3DABWW",imageSet:"/images/products/books/purchaseLinks/US/prisoner/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158327/harry-potter-and-the-prisoner-of-azkaban-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/prisoner/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/prisoner/illustrated.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-prisoner-of-azkaban-9781408855676",imageSet:"/images/products/books/purchaseLinks/UK/prisoner/print.jpg"},{title:"eBook",link:"http://lnk.to/HP3eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/prisoner/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP3DABWW",imageSet:"/images/products/books/purchaseLinks/UK/prisoner/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-prisoner-of-azkaban-9781408882269/",imageSet:"/images/products/books/purchaseLinks/UK/prisoner/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-prisoner-of-azkaban-9781408845660",imageSet:"/images/products/books/purchaseLinks/UK/prisoner/illustrated.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Goblet of Fire",displayTitle:"Harry Potter and the Goblet of Fire",externalId:"harry-potter-and-the-goblet-of-fire",seriesNumber:4,imageSet:{US:"/images/products/books/US/rectangle-4.jpg",UK:"/images/products/books/UK/rectangle-4.jpg"},text:{US:"Harry Potter wants to get away from the pernicious Dursleys and go to the Quidditch World Cup with Hermione, Ron, and the Weasleys. He wants to dream about Cho Chang, his crush (and maybe do more than dream). He wants to find out about the mysterious event involving two other rival schools of magic, and a competition that hasn’t happened for hundreds of years. He wants to be a normal, fourteen-year-old wizard. Unfortunately for Harry Potter, he’s not normal; he’s different — even by Wizarding standards. And in his case, different can be deadly.",UK:"The Triwizard Tournament is to be held at Hogwarts. Only wizards who are over seventeen are allowed to enter – but that doesn’t stop Harry dreaming that he will win the competition. Then at Hallowe’en, when the Goblet of Fire makes its selection, Harry is amazed to find his name is one of those that the magical cup picks out. He will face death-defying tasks, dragons and Dark wizards, but with the help of his best friends, Ron and Hermione, he might just make it through – alive!"},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/goblet/print.jpg"},{title:"eBook",link:"http://lnk.to/HP4eBookWW",imageSet:"/images/products/books/purchaseLinks/US/goblet/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP4DABWW",imageSet:"/images/products/books/purchaseLinks/US/goblet/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158324/harry-potter-and-the-goblet-of-fire-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/goblet/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/goblet/illustrated.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-goblet-of-fire-9781408855683",imageSet:"/images/products/books/purchaseLinks/UK/goblet/print.jpg"},{title:"eBook",link:"http://lnk.to/HP4eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/goblet/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP4DABWW",imageSet:"/images/products/books/purchaseLinks/UK/goblet/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-goblet-of-fire-9781408882276/",imageSet:"/images/products/books/purchaseLinks/UK/goblet/physical-audiobook.jpg"},{title:"Illustrated Edition",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-goblet-of-fire-9781408845677",imageSet:"/images/products/books/purchaseLinks/UK/goblet/illustrated.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Order of the Phoenix",displayTitle:"Harry Potter and the Order of the Phoenix",externalId:"harry-potter-and-the-order-of-the-phoenix",seriesNumber:5,imageSet:{US:"/images/products/books/US/rectangle-5.jpg",UK:"/images/products/books/UK/rectangle-5.jpg"},text:{UK:"Dark times have come to Hogwarts. After the Dementors’ attack on his cousin Dudley, Harry Potter knows that Voldemort will stop at nothing to find him. There are many who deny the Dark Lord’s return, but Harry is not alone: a secret Order gathers at Grimmauld Place to fight against the Dark forces. Harry must allow Professor Snape to teach him how to protect himself from Voldemort’s savage assaults on his mind. But they are growing stronger by the day and Harry is running out of time.",US:"The rebellion begins! Lord Voldemort has returned, but the Ministry of Magic is doing everything it can to keep the wizarding world from knowing the truth – including appointing Ministry official Dolores Umbridge as the new Defence Against the Dark Arts professor at Hogwarts. When Umbridge refuses to teach practical defensive magic, Ron and Hermione convince Harry to secretly train a select group of students for the wizarding war that lies ahead. A terrifying showdown between good and evil awaits in this enthralling film version of the fifth novel in J.K. Rowling’s Harry Potter series. Prepare for battle!"},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/order/print.jpg"},{title:"eBook",link:"http://lnk.to/HP5eBookWW",imageSet:"/images/products/books/purchaseLinks/US/order/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP5DABWW",imageSet:"/images/products/books/purchaseLinks/US/order/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158326/harry-potter-and-the-order-of-the-phoenix-by-j-k-rowling/9780807220290/",imageSet:"/images/products/books/purchaseLinks/US/order/physical-audiobook.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-order-of-the-phoenix-9781408855690",imageSet:"/images/products/books/purchaseLinks/UK/order/print.jpg"},{title:"eBook",link:"http://lnk.to/HP5eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/order/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP5DABWW",imageSet:"/images/products/books/purchaseLinks/UK/order/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-order-of-the-phoenix-9781408882238/",imageSet:"/images/products/books/purchaseLinks/UK/order/physical-audiobook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Half-Blood Prince",displayTitle:"Harry Potter and the Half-Blood Prince",externalId:"harry-potter-and-the-half-blood-prince",seriesNumber:6,imageSet:{US:"/images/products/books/US/rectangle-6.jpg",UK:"/images/products/books/UK/rectangle-6.jpg"},text:{UK:"When Dumbledore arrives at Privet Drive one summer night to collect Harry Potter, his wand hand is blackened and shrivelled, but he does not reveal why. Secrets and suspicion are spreading through the wizarding world, and Hogwarts itself is not safe. Harry is convinced that Malfoy bears the Dark Mark: there is a Death Eater amongst them. Harry will need powerful magic and true friends as he explores Voldemort’s darkest secrets, and Dumbledore prepares him to face his destiny.",US:"The war against Voldemort is not going well. Hermione scans the pages of the Daily Prophet, reading out terrible news. Dumbledore is absent from Hogwarts for long stretches of time, and yet . . . As in all wars, life goes on. Sixth-year students learn to Apparate — and lose a few eyebrows in the process. Teenagers flirt and fight and fall in love. Classes are tough, though Harry receives some extraordinary help from the mysterious Half-Blood Prince. And all the while Harry searches for the full and complex story of the boy who became Lord Voldemort — hoping to find what may be his only vulnerability."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/halfBlood/print.jpg"},{title:"eBook",link:"http://lnk.to/HP6eBookWW",imageSet:"/images/products/books/purchaseLinks/US/halfBlood/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP6DABWW",imageSet:"/images/products/books/purchaseLinks/US/halfBlood/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158325/harry-potter-and-the-half-blood-prince-by-j-k-rowling/9780307283658/",imageSet:"/images/products/books/purchaseLinks/US/halfBlood/physical-audiobook.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-halfblood-prince-9781408855706",imageSet:"/images/products/books/purchaseLinks/UK/halfBlood/print.jpg"},{title:"eBook",link:"http://lnk.to/HP6eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/halfBlood/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP6DABWW",imageSet:"/images/products/books/purchaseLinks/UK/halfBlood/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-halfblood-prince-9781408882283/",imageSet:"/images/products/books/purchaseLinks/UK/halfBlood/physical-audiobook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Deathly Hallows",displayTitle:"Harry Potter and the Deathly Hallows",externalId:"harry-potter-and-the-deathly-hallows",seriesNumber:7,imageSet:{US:"/images/products/books/US/rectangle-7.jpg",UK:"/images/products/books/UK/rectangle-7.jpg"},text:{UK:"As he climbs into the sidecar of Hagrid’s motorbike and takes to the skies, leaving Privet Drive for the last time, Harry Potter knows that Lord Voldemort and the Death Eaters are not far behind. The protective charm that has kept Harry safe until now is broken, but he cannot keep hiding. The Dark Lord is breathing fear into everything Harry loves, and to stop him Harry will have to find and destroy the remaining Horcruxes. The final battle must begin – Harry must stand and face his enemy.",US:"It's no longer safe for Harry at Hogwarts, so he and his best friends, Ron and Hermione, are on the run. Professor Dumbledore has given them clues about what they need to do to defeat the dark wizard, Lord Voldemort, once and for all, but it's up to them to figure out what these hints and suggestions really mean. Their cross-country odyssey has them searching desperately for the answers, while evading capture or death at every turn. At the same time, their friendship, fortitude, and sense of right and wrong are tested in ways they never could have imagined. The ultimate battle between good and evil that closes out this final chapter of the epic series takes place where Harry's Wizarding life began: at Hogwarts. The satisfying conclusion offers shocking last-minute twists, incredible acts of courage, powerful new forms of magic, and the resolution of many mysteries. Above all, this intense, cathartic book serves as a clear statement of the message at the heart of the Harry Potter series: that choice matters much more than destiny, and that love will always triumph over death."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/deathly/print.jpg"},{title:"eBook",link:"http://lnk.to/HP7eBookWW",imageSet:"/images/products/books/purchaseLinks/US/deathly/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP7DABWW",imageSet:"/images/products/books/purchaseLinks/US/deathly/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.penguinrandomhouse.com/books/158322/harry-potter-and-the-deathly-hallows-by-j-k-rowling/9780739360385/",imageSet:"/images/products/books/purchaseLinks/US/deathly/physical-audiobook.jpg"}],UK:[{title:"Print",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-deathly-hallows-9781408855713",imageSet:"/images/products/books/purchaseLinks/UK/deathly/print.jpg"},{title:"eBook",link:"http://lnk.to/HP7eBookWW",imageSet:"/images/products/books/purchaseLinks/UK/deathly/ebook.jpg"},{title:"Digital Audiobook",link:"http://lnk.to/HP7DABWW",imageSet:"/images/products/books/purchaseLinks/UK/deathly/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://www.bloomsbury.com/uk/harry-potter-and-the-deathly-hallows-cd-9781408882245/",imageSet:"/images/products/books/purchaseLinks/UK/deathly/physical-audiobook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter and the Cursed Child",franchiseSubTitle:"Parts One and Two",displayTitle:"Harry Potter and the Cursed Child - Parts One and Two",externalId:"harry-potter-and-the-cursed-child-parts-one-and-two-screenplay",imageSet:{US:"/images/products/books/US/rectangle-8.jpg",UK:"/images/products/books/UK/rectangle-8.jpg"},text:{UK:"The official playscript of the original West End production of Harry Potter and the Cursed Child. It was always difficult being Harry Potter and it isn’t much easier now that he is an overworked employee of the Ministry of Magic, a husband, and father of three school-age children. While Harry grapples with a past that refuses to stay where it belongs, his youngest son Albus must struggle with the weight of a family legacy he never wanted. As past and present fuse ominously, both father and son learn the uncomfortable truth: sometimes, darkness comes from unexpected places. The playscript for Harry Potter and the Cursed Child was originally released as a ‘special rehearsal edition’ alongside the opening of Jack Thorne’s play in London’s West End in summer 2016. Based on an original story by J.K. Rowling, John Tiffany and Jack Thorne, the play opened to rapturous reviews from theatregoers and critics alike, while the official playscript became an immediate global bestseller. This revised paperback edition updates the ‘special rehearsal edition’ with the conclusive and final dialogue from the play, which has subtly changed since its rehearsals, as well as a conversation piece between director John Tiffany and writer Jack Thorne, who share stories and insights about reading playscripts. This edition also includes useful background information including the Potter family tree and a timeline of events from the wizarding world prior to the beginning of Harry Potter and the Cursed Child.",US:'The Eighth Story. Nineteen Years Later. It was always difficult being Harry Potter and it isn\'t much easier now that he is an overworked employee of the Ministry of Magic, a husband, and father of three school-age children. While Harry grapples with a past that refuses to stay where it belongs, his youngest son, Albus, must struggle with the weight of a family legacy he never wanted. As past and present fuse ominously, both father and son learn the uncomfortable truth: Sometimes, darkness comes from unexpected places. The playscript for Harry Potter and the Cursed Child was originally released as a "special rehearsal edition" alongside the opening of Jack Thorne\'s play in London\'s West End in summer 2016. Based on an original story by J.K. Rowling, John Tiffany, and Jack Thorne, the play opened to rapturous reviews from theatergoers and critics alike, while the official playscript became an immediate global bestseller. This revised paperback edition updates the "special rehearsal edition" with the conclusive and final dialogue from the play, which has subtly changed since its rehearsals, as well as a conversation piece between director John Tiffany and writer Jack Thorne, who share stories and insights about reading playscripts. This edition also includes useful background information including the Potter family tree and a timeline of events from the wizarding world prior to the beginning of Harry Potter and the Cursed Child.'},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://shop.scholastic.com/teachers-ecommerce/teacher/books/harry-potter-and-the-cursed-child-parts-one-two-9781338216660.html",imageSet:"/images/products/books/purchaseLinks/US/cursed/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/cursed-child-ebook/products/harry_potter_and_the_cursed_child_de_9781781105535",imageSet:"/images/products/books/purchaseLinks/US/cursed/ebook.jpg"}],UK:[{title:"Print",link:"https://www.littlebrown.co.uk/titles/j-k-rowling/harry-potter-and-the-cursed-child-parts-one-and-two/9780751565362/",imageSet:"/images/products/books/purchaseLinks/UK/cursed/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/cursed-child-ebook/products/harry_potter_and_the_cursed_child_de_9781781105528",imageSet:"/images/products/books/purchaseLinks/UK/cursed/ebook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1}]},{collectionTitle:"Fantastic Beasts",products:[{franchiseName:"Fantastic Beasts",franchiseSubTitle:"and Where to Find Them",displayTitle:"Fantastic Beasts and Where to Find Them",externalId:"fantastic-beasts-and-where-to-find-them-screenplay",imageSet:{US:"/images/products/books/US/rectangle-11.jpg",UK:"/images/products/books/UK/rectangle-11.jpg"},text:{UK:" J.K. Rowling invites you to explore a new era of the Wizarding World . . .\nWhen Magizoologist Newt Scamander arrives in New York, he intends his stay to be just a brief stopover. However, when his magical case is misplaced and some of Newt’s fantastic beasts escape, it spells trouble for everyone . . .\nInspired by the original Hogwart’s textbook by Newt Scamander, Fantastic Beasts and Where to Find Them: The Original screenplay marks the screenwriting debut of J.K. Rowling, author of the beloved and internationally bestselling Harry Potter books. A feat of imagination and featuring a cast of remarkable characters and magical creatures, this is epic adventure-packed storytelling at its very best. Whether an existing fan or new to the wizarding world, this is a perfect addition for any film lover or reader’s bookshelf.",US:" J.K. Rowling invites you to explore a new era of the Wizarding World . . .\nWhen Magizoologist Newt Scamander arrives in New York, he intends his stay to be just a brief stopover. However, when his magical case is misplaced and some of Newt’s fantastic beasts escape, it spells trouble for everyone . . .\nInspired by the original Hogwart’s textbook by Newt Scamander, Fantastic Beasts and Where to Find Them: The Original screenplay marks the screenwriting debut of J.K. Rowling, author of the beloved and internationally bestselling Harry Potter books. A feat of imagination and featuring a cast of remarkable characters and magical creatures, this is epic adventure-packed storytelling at its very best. Whether an existing fan or new to the wizarding world, this is a perfect addition for any film lover or reader’s bookshelf."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kids/book/fantastic-beasts-and-where-to-find-them-the-original-screenplay-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/fb1Screenplay/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/fantastic-beasts-screenplays-ebook/products/fantastic_beasts_and_where_to_find_them_the_original_screenplay_9781781109601",imageSet:"/images/products/books/purchaseLinks/US/fb1Screenplay/ebook.jpg"}],UK:[{title:"Print",link:"https://www.littlebrown.co.uk/titles/j-k-rowling/fantastic-beasts-and-where-to-find-them/9780751574951/",imageSet:"/images/products/books/purchaseLinks/UK/fb1Screenplay/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/fantastic-beasts-screenplays-ebook/products/fantastic_beasts_and_where_to_find_them_the_original_screenplay_9781781107140",imageSet:"/images/products/books/purchaseLinks/UK/fb1Screenplay/ebook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Fantastic Beasts",franchiseSubTitle:"The Crimes of Grindelwald",displayTitle:"Fantastic Beasts: The Crimes of Grindelwald",externalId:"fantastic-beasts-the-crimes-of-grindelwald",imageSet:{US:"/images/products/books/US/rectangle-10.jpg",UK:"/images/products/books/UK/rectangle-10.jpg"},text:{UK:"The Wizarding World journey continues . . . The powerful Dark wizard Gellert Grindelwald was captured in New York with the help of Newt Scamander. But, making good on his threat, Grindelwald escapes custody and sets about gathering followers, most of whom are unsuspecting of his true agenda: to raise pure-blood wizards up to rule over all non-magical beings. In an effort to thwart Grindelwald’s plans, Albus Dumbledore enlists Newt, his former Hogwarts student, who agrees to help once again, unaware of the dangers that lie ahead. Lines are drawn as love and loyalty are tested, even among the truest friends and family, in an increasingly divided wizarding world. Fantastic Beasts: The Crimes of Grindelwald is the second screenplay in a five-film series to be written by J.K. Rowling, author of the internationally bestselling Harry Potter books. Set in 1927, a few months after the events of Fantastic Beasts and Where To Find Them, and moving from New York to London, Paris and even back to Hogwarts, this story of mystery and magic reveals an extraordinary new chapter in the wizarding world. Illustrated with stunning line art from MinaLima with some surprising nods to the Harry Potter stories that will delight fans of both the books and films.",US:"The Wizarding World journey continues . . . The powerful Dark wizard Gellert Grindelwald was captured in New York with the help of Newt Scamander. But, making good on his threat, Grindelwald escapes custody and sets about gathering followers, most of whom are unsuspecting of his true agenda: to raise pure-blood wizards up to rule over all non-magical beings. In an effort to thwart Grindelwald’s plans, Albus Dumbledore enlists Newt, his former Hogwarts student, who agrees to help once again, unaware of the dangers that lie ahead. Lines are drawn as love and loyalty are tested, even among the truest friends and family, in an increasingly divided wizarding world. Fantastic Beasts: The Crimes of Grindelwald is the second screenplay in a five-film series to be written by J.K. Rowling, author of the internationally bestselling Harry Potter books. Set in 1927, a few months after the events of Fantastic Beasts and Where To Find Them, and moving from New York to London, Paris and even back to Hogwarts, this story of mystery and magic reveals an extraordinary new chapter in the wizarding world. Illustrated with stunning line art from MinaLima with some surprising nods to the Harry Potter stories that will delight fans of both the books and films."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kids/book/fantastic-beasts-the-crimes-of-grindelwald-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/fb2Screenplay/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/fantastic-beasts-screenplays-ebook/products/fantastic_beasts_the_crimes_of_grindelwald__the_original_screenplay_9781781102343",imageSet:"/images/products/books/purchaseLinks/US/fb2Screenplay/ebook.jpg"}],UK:[{title:"Print",link:"https://www.littlebrown.co.uk/titles/j-k-rowling/fantastic-beasts-the-crimes-of-grindelwald-%e2%80%93-the-original-screenplay/9780751578287/",imageSet:"/images/products/books/purchaseLinks/UK/fb2Screenplay/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/fantastic-beasts-screenplays-ebook/products/fantastic_beasts_the_crimes_of_grindelwald__the_original_screenplay_9781781102336",imageSet:"/images/products/books/purchaseLinks/UK/fb2Screenplay/ebook.jpg"}]},showFranchiseName:!1},{franchiseName:"Fantastic Beasts",franchiseSubTitle:"The Secrets of Dumbledore",displayTitle:"Fantastic Beasts: The Secrets of Dumbledore",externalId:"fantastic-beasts-the-secrets-of-dumbledore",imageSet:{US:"/images/products/books/US/fb-secrets-dumbledore.jpg",UK:"/images/products/books/US/fb-secrets-dumbledore.jpg"},text:{UK:"Professor Albus Dumbledore knows the powerful Dark wizard Gellert Grindelwald is moving to seize control of the wizarding world. Unable to stop him alone, he entrusts Magizoologist Newt Scamander to lead an intrepid team of wizards, witches, and one brave Muggle baker on a dangerous mission, where they encounter old and new beasts and clash with Grindelwald’s growing legion of followers. But with the stakes so high, how long can Dumbledore remain on the sidelines?\n\nThe official screenplay of Fantastic Beasts: The Secrets of Dumbledore is the ultimate companion to the film, and invites readers to explore every scene of the complete script penned by J.K. Rowling & Steve Kloves. Special features include behind-the-scenes content and commentary from David Yates, David Heyman, Jude Law, Eddie Redmayne, Colleen Atwood and more.",US:"Professor Albus Dumbledore knows the powerful Dark wizard Gellert Grindelwald is moving to seize control of the wizarding world. Unable to stop him alone, he entrusts Magizoologist Newt Scamander to lead an intrepid team of wizards, witches, and one brave Muggle baker on a dangerous mission, where they encounter old and new beasts and clash with Grindelwald’s growing legion of followers. But with the stakes so high, how long can Dumbledore remain on the sidelines?\n\nThe official screenplay of Fantastic Beasts: The Secrets of Dumbledore is the ultimate companion to the film, and invites readers to explore every scene of the complete script penned by J.K. Rowling & Steve Kloves. Special features include behind-the-scenes content and commentary from David Yates, David Heyman, Jude Law, Eddie Redmayne, Colleen Atwood and more."},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kid/books/harry-potter/",imageSet:"/images/products/books/purchaseLinks/US/fb3Screenplay/print.jpg"},{title:"eBook",link:"/linkout?destination=https://www.amazon.com/-/en/J-K-Rowling-ebook/dp/B09WF65RV8/ref=sr_1_1?__mk_es_US=%C3%85M%C3%85%C5%BD%C3%95%C3%91&crid=1P145I9OP3Q2Z&keywords=fantastic+beasts+the+secrets+of+dumbledore&qid=1657616552&s=books&sprefix=fantastic+beasts+the+secrets+of+dumbledore%2Cstripbooks%2C191&sr=1-1&language=en_US",imageSet:"/images/products/books/purchaseLinks/US/fb3Screenplay/ebook.jpg"}],UK:[{title:"Print",link:"https://geni.us/SecretsOfDumbledore",imageSet:"/images/products/books/purchaseLinks/UK/fb3Screenplay/print.jpg"},{title:"eBook",link:"/linkout?destination=https://www.amazon.co.uk/Fantastic-Beasts-Dumbledore-Complete-Screenplay-ebook/dp/B09WF785D6/ref=sr_1_1?crid=1VFK7JOL12LDN&keywords=9781789391350&qid=1657556664&sprefix=9781789391350%2Caps%2C145&sr=8-1",imageSet:"/images/products/books/purchaseLinks/UK/fb3Screenplay/ebook.jpg"}]},showFranchiseName:!1}]},{collectionTitle:"Hogwarts Library",products:[{franchiseName:"Fantastic Beasts",franchiseSubTitle:"and Where to Find Them",displayTitle:"Fantastic Beasts and Where to Find Them",externalId:"fantastic-beasts-and-where-to-find-them",imageSet:{US:"/images/products/books/US/rectangle-9.jpg",UK:"/images/products/books/UK/rectangle-9.jpg"},text:{UK:"An approved textbook at Hogwarts School of Witchcraft and Wizardry since publication, Newt Scamander's masterpiece has entertained wizarding families through the generations. Fantastic Beasts and Where to Find Them is an indispensable introduction to the magical beasts of the Wizarding World. In this comprehensively updated edition, eagle-eyed readers will spot a number of new beasts and an intriguing new author's note. Scamander's years of travel and research have created a tome of unparalleled importance. Some of the beasts will be familiar to readers of the Harry Potter books – the Hippogriff, the Basilisk, the Hungarian Horntail ... Others will surprise even the most ardent amateur Magizoologist. Dip in to discover the curious habits of magical beasts across five continents … 'No wizarding household is complete without a copy' – Albus Dumbledore",US:"Straight from the library at Hogwarts School of Witchcraft and Wizardry, a book of magical creatures that no Harry Potter fan should be without! Fantastic Beasts and Where to Find Them, Newt Scamander’s classic compendium of magical creatures, has delighted generations of wizarding readers. Now, in this updated edition with a new foreword by Newt himself and the unveiling of six beasts little known outside the American wizarding community, Muggles too have the chance to discover where the Thunderbird lives, what the Puffskein eats, and why shiny objects should always be kept away from the Niffler. Proceeds from the sale of this book will go to Comic Relief and Lumos, which means that the dollars you exchange for it will do magic beyond the powers of any wizard. If you feel that this is insufficient reason to part with your money, one can only hope that passing wizards feel more charitable if they see you being attacked by a Manticore. "},typeSlug:"books",purchaseLinks:{UK:[{title:"Print",link:"https://harrypotter.bloomsbury.com/fantastic-beasts-where-to-find-them-hogwarts-library-9781408896945/",imageSet:"/images/products/books/purchaseLinks/UK/fantasticBeasts/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/fantastic_beasts_and_where_to_find_them_9781781105566",imageSet:"/images/products/books/purchaseLinks/UK/fantasticBeasts/ebook.jpg"},{title:"Digital Audiobook",link:"https://uk.shop.pottermore.com/collections/hogwarts-library-books-audio-book/products/fantastic_beasts_and_where_to_find_them_9781781108925",imageSet:"/images/products/books/purchaseLinks/UK/fantasticBeasts/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://harrypotter.bloomsbury.com/uk/fantastic-beasts-and-where-to-find-them-audio-9781408893159/?ewid=455",imageSet:"/images/products/books/purchaseLinks/UK/fantasticBeasts/physical-audiobook.jpg"},{title:"Illustrated edition",link:"https://harrypotter.bloomsbury.com/fantastic-beasts-where-to-find-them-illustrated-edition-9781526606167-9781408885260/",imageSet:"/images/products/books/purchaseLinks/UK/fantasticBeasts/illustrated.jpg"}],US:[{title:"Print",link:"https://kids.scholastic.com/kids/book/fantastic-beasts-and-where-to-find-them-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/fantasticBeasts/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/fantastic_beasts_and_where_to_find_them_9781781105757",imageSet:"/images/products/books/purchaseLinks/US/fantasticBeasts/ebook.jpg"},{title:"Digital Audiobook",link:"https://usd.shop.pottermore.com/collections/hogwarts-library-books-audio-book/products/fantastic_beasts_and_where_to_find_them_9781781108925",imageSet:"/images/products/books/purchaseLinks/US/fantasticBeasts/digital-audiobook.jpg"},{title:"Illustrated edition",link:"https://kids.scholastic.com/kids/book/fantastic-beasts-and-where-to-find-them-9781338216790/",imageSet:"/images/products/books/purchaseLinks/US/fantasticBeasts/illustrated.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"",franchiseSubTitle:"Quidditch Through the Ages",displayTitle:"Quidditch Through the Ages",externalId:"quidditch-through-the-ages",imageSet:{US:"/images/products/books/US/rectangle-12.jpg",UK:"/images/products/books/UK/rectangle-12.jpg"},text:{UK:"A perennial bestseller in the wizarding world and one of the most popular books in the Hogwarts School library, Quidditch Through the Ages contains all you will ever need to know about the history, the rules – and the breaking of the rules – of the noble sport of Quidditch. Packed with fascinating facts, this definitive guide by the esteemed Quidditch writer Kennilworthy Whisp charts the game's history from its early origins in the medieval mists on Queerditch Marsh, through to the modern-day sport loved by so many wizard and Muggle families around the world. With comprehensive coverage of famous Quidditch teams, the commonest fouls, the development of racing brooms, and much more, this is a must-have sporting bible for all Harry Potter fans, Quidditch lovers and players, whether the weekend amateur or the seasoned Chudley Cannons season-ticket holder. A contribution from the sale of each book will go to Comic Relief.",US:"The most checked-out book in the Hogwarts Library, and a volume no Quidditch player or Harry Potter fan should be without! If you have ever asked yourself where the Golden Snitch came from, how the Bludgers came into existence, or why the Wigtown Wanderers have pictures of meat cleavers on their robes, you need Quidditch Through the Ages. This invaluable volume is consulted by young Quidditch fans on an almost daily basis. Proceeds from the sale of this book will go to Comic Relief and Lumos, who will use your money to continue improving and changing lives – work that is even more important and astonishing than the three and a half second capture of the Golden Snitch by Roderick Plumpton in 1921. "},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kids/book/quidditch-through-the-ages-by-kennilworthy-whisp/",imageSet:"/images/products/books/purchaseLinks/US/quidditch/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/quidditch_through_the_ages_9781781106969",imageSet:"/images/products/books/purchaseLinks/US/quidditch/ebook.jpg"},{title:"Digital Audiobook",link:"https://usd.shop.pottermore.com/collections/hogwarts-library-books-audio-book/products/quidditch_through_the_ages_9781781109908",imageSet:"/images/products/books/purchaseLinks/US/quidditch/digital-audiobook.jpg"}],UK:[{title:"Print",link:"https://harrypotter.bloomsbury.com/quidditch-through-the-ages-9781408883082/",imageSet:"/images/products/books/purchaseLinks/UK/quidditch/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/quidditch_through_the_ages_9781781106747",imageSet:"/images/products/books/purchaseLinks/UK/quidditch/ebook.jpg"},{title:"Digital Audiobook",link:"https://uk.shop.pottermore.com/collections/hogwarts-library-books-audio-book/products/quidditch_through_the_ages_9781781109908",imageSet:"/images/products/books/purchaseLinks/UK/quidditch/digital-audiobook.jpg"},{title:"Physical Audiobook",link:"https://harrypotter.bloomsbury.com/uk/quidditch-through-the-ages-audio-9781526603029/?ewid=455",imageSet:"/images/products/books/purchaseLinks/UK/quidditch/physical-audiobook.jpg"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"",franchiseSubTitle:"The Tales of Beedle The Bard",displayTitle:"The Tales of Beedle The Bard",externalId:"tales-of-beedle-the-bard",imageSet:{US:"/images/products/books/US/rectangle-13.jpg",UK:"/images/products/books/UK/rectangle-13.jpg"},text:{UK:"The Tales of Beedle the Bard have been favourite bedtime reading in wizarding households for centuries. Full of magic and trickery, these classic tales both entertain and instruct, and remain as captivating to young wizards today as they were when Beedle first put quill to parchment in the fifteenth century. There are five tales in all: 'The Tale of the Three Brothers' Harry Potter fans will know from Harry Potter and the Deathly Hallows; 'The Fountain of Fair Fortune', 'The Warlock's Hairy Heart', 'The Wizard and the Hopping Pot' and 'Babbitty Rabbitty and her Cackling Stump' complete the collection. These narrative gems are accompanied by explanatory notes by Professor Albus Dumbledore (included by kind permission of the Hogwarts Headmaster's archive). His illuminating thoughts reveal the stories to be much more than just simple moral tales, and are sure to make Babbitty Rabbitty and the slug-belching Hopping Pot as familiar to Muggles as Snow White and Cinderella. \nThe Tales of Beedle the Bard is published in aid of the Lumos (www.wearelumos.org), an international children's charity (registered charity number 1112575) founded in 2005 by J.K. Rowling. Lumos is dedicated ending the institutionalisation of children, a harmful practice that affects the lives of up to eight million disadvantaged children around the world who live in institutions and orphanages, many placed there as a result of poverty, disability, disease, discrimination and conflict; very few are orphans. Lumos works to reunite children with their families, promote family-based care alternatives and help authorities to reform their systems and close down institutions and orphanages.",US:'From J.K. Rowling, a classic Hogwarts Library book, and the perfect addition to the bookshelf of every Harry Potter fan. The Tales of Beedle the Bard, a wizarding classic, first came to Muggle readers\' attention in the book known as Harry Potter and the Deathly Hallows. Now, thanks to Hermione Granger\'s new translation from the ancient runes, we present this stunning edition with an introduction, notes, and illustrations by J.K. Rowling, and extensive commentary by Albus Dumbledore. Never before have Muggles been privy to these richly imaginative tales: "The Wizard and the Hopping Pot," "The Fountain of Fair Fortune," "The Warlock\'s Hairy Heart," "Babbitty Rabbitty and Her Cackling Stump," and of course "The Tale of the Three Brothers." Not only are they the equal of fairy tales we know and love, reading them gives new insight into the wizarding world.'},typeSlug:"books",purchaseLinks:{US:[{title:"Print",link:"https://kids.scholastic.com/kids/book/the-tales-of-beedle-the-bard-by-j-k-rowling/",imageSet:"/images/products/books/purchaseLinks/US/beedle/print.jpg"},{title:"eBook",link:"https://usd.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/the_tales_of_beedle_the_bard_9781781106976",imageSet:"/images/products/books/purchaseLinks/US/beedle/ebook.jpg"},{title:"Illustrated edition",link:"https://kids.scholastic.com/kids/book/the-tales-of-beedle-the-bard-9781338262186/",imageSet:"/images/products/books/purchaseLinks/US/beedle/illustrated.jpg"}],UK:[{title:"Print",link:"https://harrypotter.bloomsbury.com/the-tales-of-beedle-the-bard-9781408883099/",imageSet:"/images/products/books/purchaseLinks/UK/beedle/print.jpg"},{title:"eBook",link:"https://uk.shop.pottermore.com/collections/hogwarts-library-books-ebook/products/the_tales_of_beedle_the_bard_9781781106754",imageSet:"/images/products/books/purchaseLinks/UK/beedle/ebook.jpg"},{title:"Illustrated edition",link:"https://harrypotter.bloomsbury.com/the-tales-of-beedle-the-bard-illustrated-edition-9781408898673/",imageSet:"/images/products/books/purchaseLinks/UK/beedle/illustrated.jpg"}]},showFranchiseName:!1}]}],footer:{eyebrow:"Download Now",title:"Wizarding World App",description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque condimentum elit vitae sapien vulputate.",download:{link:"",label:"Find Out More"}}},films:{metaContent:{title:"Harry Potter | Harry Potter and Fantastic Beasts Films",description:"So far, the Wizarding World has given us eight Harry Potter films and two Fantastic Beasts films to watch over and over. Discover how the beloved movies brought the magic to life."},header:{eyebrow:"discover the wizarding world",title:{UK:"Films",US:"Movies"},description:"J.K. Rowling’s beloved Harry Potter novels were brought to life on screen in eight blockbuster films and went on to inspire the Fantastic Beasts film series, taking us into a new era of the Wizarding World."},collections:[{collectionTitle:"Harry Potter",products:[{franchiseName:"Harry Potter",franchiseSubTitle:{UK:"and the Philosopher's Stone",US:"and the Sorcerer's Stone"},displayTitle:{UK:"Harry Potter and the Philosopher's Stone",US:"Harry Potter and the Sorcerer's Stone"},externalId:"harry-potter-and-the-philosophers-stone",seriesNumber:1,imageSet:"/images/products/films/rectangle-1.png",text:"In this enchanting, three-time Oscar nominated film adaptation of J.K. Rowling's delightful bestseller (and the first entry in the most successful movie series in box-office history), Harry Potter learns on his 11th birthday that he is the orphaned first son of two powerful wizards and possesses magical powers of his own. At Hogwarts School of Witchcraft and Wizardry, Harry embarks on the adventure of a lifetime. He learns the high-flying sport Quidditch and plays a thrilling game with living chess pieces on his way to face a Dark Wizard bent on destroying him. For the most extraordinary adventure, see you on platform nine and three-quarters!",typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-sorcerers-stone/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-philosophers-stone"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Chamber of Secrets",displayTitle:"Harry Potter and the Chamber of Secrets",externalId:"harry-potter-and-the-chamber-of-secrets",seriesNumber:2,imageSet:"/images/products/films/rectangle-2.png",text:{UK:"The second instalment in the Harry Potter series finds young wizard Harry Potter (Daniel Radcliffe) and his friends Ron Weasley (Rupert Grint) and Hermione Granger (Emma Watson) facing new challenges during their second year at Hogwarts School of Witchcraft and Wizardry as they try to uncover a dark force that is terrorising the school.",US:"The second installment in the Harry Potter series finds young wizard Harry Potter (Daniel Radcliffe) and his friends Ron Weasley (Rupert Grint) and Hermione Granger (Emma Watson) facing new challenges during their second year at Hogwarts School of Witchcraft and Wizardry as they try to uncover a dark force that is terrorizing the school."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-chamber-secrets/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-chamber-of-secrets"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Prisoner of Azkaban",displayTitle:"Harry Potter and the Prisoner of Azkaban",externalId:"harry-potter-and-the-prisoner-of-azkaban",seriesNumber:3,imageSet:"/images/products/films/rectangle-3.png",text:{UK:"In Harry Potter and the Prisoner of Azkaban, Harry, Ron and Hermione, now teenagers, return for their third year at Hogwarts, where they are forced to face escaped prisoner, Sirius Black, who poses a great threat to Harry. Harry and his friends spend their third year learning how to handle a half-horse half-eagle Hippogriff, repel shape-shifting Boggarts and master the art of Divination. They also visit the wizarding village of Hogsmeade and the Shrieking Shack, which is considered the most haunted building in Britain. In addition to these new experiences, Harry must overcome the threats of the soul-sucking Dementors, outsmart a dangerous werewolf and finally deal with the truth about Sirius Black and his relationship to Harry and his parents. With his best friends, Harry masters advanced magic, crosses the barriers of time and changes the course of more than one life. Directed by Alfonso Cuaron and based on J.K. Rowling's third book, this wondrous spellbinder soars with laughs, and the kind of breathless surprise only found in a Harry Potter adventure.",US:"In Harry Potter and the Prisoner of Azkaban, Harry, Ron and Hermione, now teenagers, return for their third year at Hogwarts, where they are forced to face escaped prisoner, Sirius Black, who poses a great threat to Harry. Harry and his friends spend their third year learning how to handle a half-horse half-eagle Hippogriff, repel shape-shifting Boggarts and master the art of Divination. They also visit the wizarding village of Hogsmeade and the Shrieking Shack, which is considered the most haunted building in Britain. In addition to these new experiences, Harry must overcome the threats of the soul-sucking Dementors, outsmart a dangerous werewolf and finally deal with the truth about Sirius Black and his relationship to Harry and his parents. With his best friends, Harry masters advanced magic, crosses the barriers of time and changes the course of more than one life. Directed by Alfonso Cuaron and based on J.K. Rowling's third book, this wondrous spellbinder soars with laughs, and the kind of breathless surprise only found in a Harry Potter adventure."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-prisoner-azkaban/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-prisoner-of-azkaban"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Goblet of Fire",displayTitle:"Harry Potter and the Goblet of Fire",externalId:"harry-potter-and-the-goblet-of-fire",seriesNumber:4,imageSet:"/images/products/films/rectangle-4.png",text:{UK:"When Harry Potter's name emerges from the Goblet of Fire, he becomes a competitor in a grueling battle for glory among three wizarding schools—the Triwizard Tournament. \nBut since Harry never submitted his name for the Tournament, who did? \nNow Harry must confront a deadly dragon, fierce water demons and an enchanted maze only to find himself in the cruel grasp of He Who Must Not Be Named. \nIn this fourth film adaptation of J.K. Rowling's Harry Potter series, everything changes as Harry, Ron and Hermione leave childhood forever and take on challenges greater than anything they could have imagined.",US:"When Harry Potter's name emerges from the Goblet of Fire, he becomes a competitor in a grueling battle for glory among three wizarding schools—the Triwizard Tournament. \nBut since Harry never submitted his name for the Tournament, who did? \nNow Harry must confront a deadly dragon, fierce water demons and an enchanted maze only to find himself in the cruel grasp of He Who Must Not Be Named. \nIn this fourth film adaptation of J.K. Rowling's Harry Potter series, everything changes as Harry, Ron and Hermione leave childhood forever and take on challenges greater than anything they could have imagined."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-goblet-fire/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-goblet-of-fire"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Order of the Phoenix",displayTitle:"Harry Potter and the Order of the Phoenix",externalId:"harry-potter-and-the-order-of-the-phoenix",seriesNumber:5,imageSet:"/images/products/films/rectangle-5.png",text:{UK:"The rebellion begins! Lord Voldemort has returned, but the Ministry of Magic is doing everything it can to keep the wizarding world from knowing the truth – including appointing Ministry official Dolores Umbridge as the new Defence Against the Dark Arts professor at Hogwarts. When Umbridge refuses to teach practical defensive magic, Ron and Hermione convince Harry to secretly train a select group of students for the wizarding war that lies ahead. A terrifying showdown between good and evil awaits in this enthralling film version of the fifth novel in J.K. Rowling’s Harry Potter series. Prepare for battle!",US:"The rebellion begins! Lord Voldemort has returned, but the Ministry of Magic is doing everything it can to keep the wizarding world from knowing the truth – including appointing Ministry official Dolores Umbridge as the new Defence Against the Dark Arts professor at Hogwarts. When Umbridge refuses to teach practical defensive magic, Ron and Hermione convince Harry to secretly train a select group of students for the wizarding war that lies ahead. A terrifying showdown between good and evil awaits in this enthralling film version of the fifth novel in J.K. Rowling’s Harry Potter series. Prepare for battle!"},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-order-phoenix/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-order-of-the-phoenix"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Half-Blood Prince",displayTitle:"Harry Potter and the Half-Blood Prince",externalId:"harry-potter-and-the-half-blood-prince",seriesNumber:6,imageSet:"/images/products/films/rectangle-6.png",text:{UK:"Voldemort is tightening his grip on both the Muggle and wizarding worlds and Hogwarts is no longer the safe haven it once was. Harry suspects that dangers may even lie within the castle, but Dumbledore is more intent upon preparing him for the final battle that he knows is fast approaching. Together they work to find the key to unlock Voldemort's defenses and, to this end, Dumbledore recruits his old friend and colleague, the well-connected and unsuspecting bon vivant Professor Horace Slughorn, whom he believes holds crucial information. Meanwhile, the students are under attack from a very different adversary as teenage hormones rage across the ramparts. Harry finds himself more and more drawn to Ginny, but so is Dean Thomas. And Lavender Brown has decided that Ron is the one for her, only she hadn't counted on Romilda Vane's chocolates! And then there's Hermione, simmering with jealously but determined not to show her feelings. As romance blossoms, one student remains aloof. He is determined to make his mark, albeit a dark one. Love is in the air, but tragedy lies ahead and Hogwarts may never be the same again.",US:"Voldemort is tightening his grip on both the Muggle and wizarding worlds and Hogwarts is no longer the safe haven it once was. Harry suspects that dangers may even lie within the castle, but Dumbledore is more intent upon preparing him for the final battle that he knows is fast approaching. Together they work to find the key to unlock Voldemort's defenses and, to this end, Dumbledore recruits his old friend and colleague, the well-connected and unsuspecting bon vivant Professor Horace Slughorn, whom he believes holds crucial information. Meanwhile, the students are under attack from a very different adversary as teenage hormones rage across the ramparts. Harry finds himself more and more drawn to Ginny, but so is Dean Thomas. And Lavender Brown has decided that Ron is the one for her, only she hadn't counted on Romilda Vane's chocolates! And then there's Hermione, simmering with jealously but determined not to show her feelings. As romance blossoms, one student remains aloof. He is determined to make his mark, albeit a dark one. Love is in the air, but tragedy lies ahead and Hogwarts may never be the same again."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-half-blood-prince/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-half-blood-prince"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Deathly Hallows Part 1",displayTitle:"Harry Potter and the Deathly Hallows Part 1",externalId:"harry-potter-and-the-deathly-hallows-part-1",seriesNumber:7,imageSet:"/images/products/films/rectangle-7.png",text:{UK:"Nominated for two Oscars, Harry Potter and the Deathly Hallows - Part 1 begins as Harry, Ron and Hermione set out on their perilous mission to track down and destroy the secret to Voldemort’s immortality and destruction—the Horcruxes. On their own, without the guidance of their professors or the protection of Professor Dumbledore, the three friends must now rely on one another more than ever. But there are Dark Forces in their midst that threaten to tear them apart. Meanwhile, the wizarding world has become a dangerous place for all enemies of the Dark Lord. The long-feared war has begun and Voldemort’s Death Eaters seize control of the Ministry of Magic and even Hogwarts, terrorizing and arresting anyone who might oppose them. But the one prize they still seek is the one most valuable to Voldemort: Harry Potter.  The Chosen One has become the hunted one as the Death Eaters search for Harry with orders to bring him to Voldemort… alive. Harry’s only hope is to find the Horcruxes before Voldemort finds him, but as he searches for clues, he uncovers an old and almost forgotten tale—the legend of the Deathly Hallows.",US:"Nominated for two Oscars, Harry Potter and the Deathly Hallows - Part 1 begins as Harry, Ron and Hermione set out on their perilous mission to track down and destroy the secret to Voldemort’s immortality and destruction—the Horcruxes. On their own, without the guidance of their professors or the protection of Professor Dumbledore, the three friends must now rely on one another more than ever. But there are Dark Forces in their midst that threaten to tear them apart. Meanwhile, the wizarding world has become a dangerous place for all enemies of the Dark Lord. The long-feared war has begun and Voldemort’s Death Eaters seize control of the Ministry of Magic and even Hogwarts, terrorizing and arresting anyone who might oppose them. But the one prize they still seek is the one most valuable to Voldemort: Harry Potter.  The Chosen One has become the hunted one as the Death Eaters search for Harry with orders to bring him to Voldemort… alive. Harry’s only hope is to find the Horcruxes before Voldemort finds him, but as he searches for clues, he uncovers an old and almost forgotten tale—the legend of the Deathly Hallows. "},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-deathly-hallows-part-1/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-deathly-hallows-part-1"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:"and the Deathly Hallows Part 2",displayTitle:"Harry Potter and the Deathly Hallows Part 2",externalId:"harry-potter-and-the-deathly-hallows-part-2",seriesNumber:8,imageSet:"/images/products/films/rectangle-8.png",text:{UK:"In Part 2 of the epic finale, the battle between the good and evil forces of the Wizarding World escalate into an all-out war. The stakes have never been higher and no one is safe. But it is Harry Potter who may be called upon to make the ultimate sacrifice as he draws closer to the climactic showdown with Lord Voldemort. It all ends here.",US:"In Part 2 of the epic finale, the battle between the good and evil forces of the Wizarding World escalate into an all-out war. The stakes have never been higher and no one is safe. But it is Harry Potter who may be called upon to make the ultimate sacrifice as he draws closer to the climactic showdown with Lord Voldemort. It all ends here."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-and-deathly-hallows-part-2/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-and-the-deathly-hallows-part-2"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Harry Potter",franchiseSubTitle:{UK:"Complete 8-Film Collection",US:"8-Film Collection"},displayTitle:{UK:"Harry Potter Complete 8-Film Collection",US:"Harry Potter 8-Film Collection"},externalId:"harry-potter-complete-8-film-collection",seriesNumber:9,imageSet:{UK:"/images/products/films/box-set-uk.png",US:"/images/products/films/box-set-us.png"},text:{UK:"When Harry Potter learns on his eleventh birthday that he is, in fact, a wizard, he is quickly swept up into the spellbinding world of Hogwarts School of Witchcraft and Wizardry alongside new best friends, Ron Weasley and Hermione Granger. He soon discovers, though, that there is a much darker side to the wizarding world than any of them could have imagined.",US:"When Harry Potter learns on his eleventh birthday that he is, in fact, a wizard, he is quickly swept up into the spellbinding world of Hogwarts School of Witchcraft and Wizardry alongside new best friends, Ron Weasley and Hermione Granger. He soon discovers, though, that there is a much darker side to the wizarding world than any of them could have imagined."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/harry-potter-complete-8-film-collection/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/harry-potter-boxset-new"}]},showFranchiseName:!1,showExternalLinkIcon:!1}]},{collectionTitle:"Fantastic Beasts",products:[{franchiseName:"Fantastic Beasts",franchiseSubTitle:"and Where to Find Them",displayTitle:"Fantastic Beasts and Where to Find Them ",externalId:"fantastic-beasts-and-where-to-find-them",seriesNumber:1,imageSet:"/images/products/films/rectangle-9.png",text:{UK:"Fantastic Beasts and Where to Find Them takes us to a new era in J.K. Rowling’s Wizarding World, decades before Harry Potter and half a world away. In 1926 New York, something mysterious is leaving a path of destruction, threatening to expose the wizarding community to fanatical No-Majs (American for Muggles) bent on eradicating them. And the dark wizard Gellert Grindelwald, after wreaking havoc in Europe, is now nowhere to be found. Magizoologist Newt Scamander arrives in the city nearing the end of a global excursion to research and rescue magical creatures, some of which are safeguarded in his nondescript leather case. Unsuspecting No-Maj Jacob Kowalski inadvertently lets some of Newt’s beasts loose in the city – a serious breach of the Statute of Secrecy that former Auror Tina Goldstein jumps on, seeing a chance to regain her post. However, things take an ominous turn when Percival Graves, the enigmatic Director of Magical Security, casts his suspicions on Newt…and Tina. Now allied, Newt and Tina, together with Tina’s sister Queenie and Jacob, form a band of unlikely heroes who must recover Newt’s missing beasts. The stakes are higher than they ever imagined as their mission puts them on a collision course with dark forces that could push the wizarding and No-Maj worlds to the brink of war.",US:"Fantastic Beasts and Where to Find Them takes us to a new era in J.K. Rowling’s Wizarding World, decades before Harry Potter and half a world away. In 1926 New York, something mysterious is leaving a path of destruction, threatening to expose the wizarding community to fanatical No-Majs (American for Muggles) bent on eradicating them. And the dark wizard Gellert Grindelwald, after wreaking havoc in Europe, is now nowhere to be found. Magizoologist Newt Scamander arrives in the city nearing the end of a global excursion to research and rescue magical creatures, some of which are safeguarded in his nondescript leather case. Unsuspecting No-Maj Jacob Kowalski inadvertently lets some of Newt’s beasts loose in the city – a serious breach of the Statute of Secrecy that former Auror Tina Goldstein jumps on, seeing a chance to regain her post. However, things take an ominous turn when Percival Graves, the enigmatic Director of Magical Security, casts his suspicions on Newt…and Tina. Now allied, Newt and Tina, together with Tina’s sister Queenie and Jacob, form a band of unlikely heroes who must recover Newt’s missing beasts. The stakes are higher than they ever imagined as their mission puts them on a collision course with dark forces that could push the wizarding and No-Maj worlds to the brink of war."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/fantastic-beasts-and-where-find-them/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/fantastic-beasts-and-where-to-find-them"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Fantastic Beasts",franchiseSubTitle:"The Crimes of Grindelwald",displayTitle:"Fantastic Beasts: The Crimes of Grindelwald",externalId:"fantastic-beasts-the-crimes-of-grindelwald",seriesNumber:2,imageSet:"/images/products/films/rectangle-10.png",text:{UK:"From the imagination of Wizarding World creator J.K. Rowling comes the Fantastic Beasts film series, magical adventures set before the time of Harry Potter. At the end of the first film, the powerful Dark wizard Gellert Grindelwald (Johnny Depp) was captured by MACUSA (Magical Congress of the United States of America), with the help of Newt Scamander (Eddie Redmayne). But, making good on his threat, Grindelwald escaped custody and has set about gathering followers, most unsuspecting of his true agenda: to raise pure-blood wizards up to rule over all non-magical beings. In an effort to thwart Grindelwald’s plans, Albus Dumbledore (Jude Law) enlists his former student Newt Scamander, who agrees to help, unaware of the dangers that lie ahead. Lines are drawn as love and loyalty are tested, even among the truest friends and family, in an increasingly divided wizarding world.",US:"From the imagination of Wizarding World creator J.K. Rowling comes the Fantastic Beasts film series, magical adventures set before the time of Harry Potter. At the end of the first film, the powerful Dark wizard Gellert Grindelwald (Johnny Depp) was captured by MACUSA (Magical Congress of the United States of America), with the help of Newt Scamander (Eddie Redmayne). But, making good on his threat, Grindelwald escaped custody and has set about gathering followers, most unsuspecting of his true agenda: to raise pure-blood wizards up to rule over all non-magical beings. In an effort to thwart Grindelwald’s plans, Albus Dumbledore (Jude Law) enlists his former student Newt Scamander, who agrees to help, unaware of the dangers that lie ahead. Lines are drawn as love and loyalty are tested, even among the truest friends and family, in an increasingly divided wizarding world."},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/fantastic-beasts-crimes-grindelwald/"}],UK:[{title:"",link:"https://www.warnerbros.co.uk/movies/fantastic-beasts-the-crimes-of-grindelwald"}]},showFranchiseName:!1,showExternalLinkIcon:!1},{franchiseName:"Fantastic Beasts",franchiseSubTitle:"The Secrets of Dumbledore",displayTitle:"Fantastic Beasts: The Secrets of Dumbledore",externalId:"fantastic-beasts-the-secrets-of-dumbledore",seriesNumber:3,imageSet:"/images/products/films/rectangle-11.png",text:{UK:"Fantastic Beasts: The Secrets of Dumbledore is the newest adventure in the Wizarding World created by J.K. Rowling.\n            Professor Albus Dumbledore (Jude Law) knows the powerful Dark wizard Gellert Grindelwald (Mads Mikkelsen) is moving to seize control of the wizarding world. Unable to stop him alone, he entrusts Magizoologist Newt Scamander (Eddie Redmayne) to lead an intrepid team of wizards, witches and one brave Muggle baker on a dangerous mission, where they encounter old and new beasts and clash with Grindelwald’s growing legion of followers. But with the stakes so high, how long can Dumbledore remain on the sidelines?",US:"Fantastic Beasts: The Secrets of Dumbledore is the newest adventure in the Wizarding World created by J.K. Rowling.\n            Professor Albus Dumbledore (Jude Law) knows the powerful Dark wizard Gellert Grindelwald (Mads Mikkelsen) is moving to seize control of the wizarding world. Unable to stop him alone, he entrusts Magizoologist Newt Scamander (Eddie Redmayne) to lead an intrepid team of wizards, witches and one brave Muggle baker on a dangerous mission, where they encounter old and new beasts and clash with Grindelwald’s growing legion of followers. But with the stakes so high, how long can Dumbledore remain on the sidelines?"},typeSlug:"films",purchaseLinks:{US:[{title:"",link:"https://www.warnerbros.com/movies/fantastic-beasts-secrets-dumbledore"}],UK:[{title:"",link:"https://www.warnerbros.com/movies/fantastic-beasts-secrets-dumbledore"}]},showFranchiseName:!1,showExternalLinkIcon:!1}]}],footer:{eyebrow:"Download Now",title:"Wizarding World App",description:"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque condimentum elit vitae sapien vulputate.",download:{link:"",label:"Find Out More"}}}}},48677:(e,t,o)=>{"use strict";o.d(t,{IB:()=>i,IH:()=>r,U3:()=>a,Y:()=>n,Zs:()=>s,i3:()=>h,mc:()=>l});let a={QUOTE:"quote",HERO:"hero",EXPANDABLE_TEXT_SECTION:"expandableTextSection",VIDEO:"video",TWO_COLUMN_CONTAINER:"twoColumnContainer",LINKS:"links",TIMELINE:"timeline",DISCOVER_PRODUCT_COLLECTION:"discoverProductCollection",CUSTOM_COMPONENT:"customComponent",TEXT_SECTION:"textSection",COUNTDOWN:"countdown",QUIZ_EVENT:"quizEvent",FLEXIBLE_CAROUSEL:"flexibleCarousel",FLEXIBLE_CONTAINER:"flexibleContainer",CONTENT_LIST:"contentList",FULL_WIDTH_PROMO:"fullWidthPromo",USER_IDENTITY_CHECKLIST:"userIdentityChecklist",IMAGE:"image",GALLERY:"gallery",EXCERPT:"excerpt",FACT_FILE_PAGE:"factFilePage",ANCILLARY:"ancillary",QUIZ:"quiz",UNLOCKABLES_ROW:"unlockablesRow",USER_PORTRAITS_ROW:"userPortraitsRow",SHOP_ROW:"shopRow",VIDEO_ROW:"videoRow",GEOTARGETED_CONTENT:"geotargetedHomepageContent",NEWSLETTER_OPT_IN:"newsletterOptIn",LOCALIZED_CONTENT:"localizedContent",USER_INTERESTS_ROW:"userInterestsRow",IDENTITY_TILE_ROW:"identityTileRow"},r=[a.QUOTE,a.HERO,a.EXPANDABLE_TEXT_SECTION,a.